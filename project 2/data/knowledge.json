{
    "intents": [
      {
        "id": "identity",
        "priority": 100,
        "kind": "info",
        "patterns": [
          "who are you",
          "what are you",
          "your name",
          "introduce yourself",
          "what is your name"
        ],
        "response": "I'm your voice assistant — a small Python service that listens for spoken commands, looks them up in a knowledge base, and responds with text and speech. I can tell you the time and date, open websites, run searches, and answer common questions. How can I help?"
      },
      {
        "id": "capabilities",
        "priority": 95,
        "kind": "info",
        "patterns": [
          "what can you do",
          "your capabilities",
          "help me",
          "what do you do",
          "how can you help"
        ],
        "response": "I can help with a few things: tell you the current time or date, open websites like Google, YouTube, GitHub, Gmail, Maps, and Wikipedia, run web searches, and answer general questions from my knowledge base. Just speak naturally — for example, \"what time is it\" or \"search for python tutorials\"."
      },
      {
        "id": "greeting",
        "kind": "smalltalk",
        "patterns": ["hello", "hi", "hey", "greetings", "good morning", "good afternoon", "good evening"],
        "response": [
          "Hello. How can I help you today?",
          "Hi there. What can I do for you?",
          "Good to hear from you. What do you need?"
        ]
      },
      {
        "id": "thanks",
        "kind": "smalltalk",
        "patterns": ["thank you", "thanks", "thanks a lot", "appreciate it", "cheers"],
        "response": [
          "You're welcome.",
          "Happy to help.",
          "Anytime."
        ]
      },
      {
        "id": "how_are_you",
        "kind": "smalltalk",
        "patterns": ["how are you", "how are you doing", "how's it going", "how do you feel"],
        "response": "I'm operating normally — thanks for asking. What can I help you with?"
      },
      {
        "id": "compliment",
        "kind": "smalltalk",
        "patterns": ["good job", "well done", "nice work", "you are smart", "you're smart", "clever"],
        "response": [
          "Thank you. I appreciate that.",
          "Glad I could help."
        ]
      },
      {
        "id": "apology",
        "kind": "smalltalk",
        "patterns": ["sorry", "my bad", "apologies"],
        "response": "No problem at all. What would you like to do next?"
